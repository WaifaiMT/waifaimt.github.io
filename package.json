{
  "name": "v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:win",
    "dev:win": "dotenv -e .env next dev",
    "dev:unix": "PORT=$(grep ^PORT= .env | cut -d= -f2) next dev",
    "build": "next build --no-lint && cp -r public .next/standalone/",
    "start": "next start -p 3001",
    "lint": "next lint"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dotenv": "^17.2.1",
    "lucide-react": "^0.526.0",
    "next": "15.4.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.0",
    "eslint": "^9",
    "eslint-config-next": "15.4.4",
    "postcss": "^8.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
